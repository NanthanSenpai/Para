{
  "expo": {
    "name": "para",
    "slug": "para",
    "scheme": "para",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.para.social",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow para to access your photos to attach images and avatars."
        }
      ]
    ]
  }
}
